# Claude route only. Copy to .env and fill keys locally; never commit credentials.
ANTHROPIC_API_KEY=
# Default Claude script authentication: generate with the official
# claude setup-token flow, then store its one-year token here locally.
# Select haiku_subscription for saved-login authentication instead.
CLAUDE_CODE_OAUTH_TOKEN=
KIMI_API_KEY=
# Separate Kimi Code account/key; not interchangeable with the Moonshot API key.
KIMI_CODE_API_KEY=
DASHSCOPE_API_KEY=
# Official Anthropic-compatible endpoint for your Qwen account/region.
DASHSCOPE_ANTHROPIC_BASE_URL=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
